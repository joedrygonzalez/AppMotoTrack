<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AppMotoTrack.Light"
        parent="Theme.Material3.Light.NoActionBar">

        <item name="colorPrimary">@color/yellow_primary</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/blue_primary</item>
        <item name="android:colorAccent">@color/yellow_primary</item>

        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:statusBarColor">@color/background_light</item>
        <item name="android:navigationBarColor">@color/background_light</item>

        <item name="colorSurface">@color/surface_white</item>

        <item name="android:windowLightStatusBar">true</item>

    </style>
    <style name="FondoRedondeado">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">30dp</item>
        <item name="cornerSizeBottomRight">30dp</item>
    </style>
</resources>