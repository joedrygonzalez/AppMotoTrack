<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    tools:context=".MotorcycleFragment">

    <!-- IMG CARD -->

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/MotoSlideImg"
        android:layout_width="0dp"
        android:layout_height="230dp"
        android:scaleType="centerCrop"
        android:src="@drawable/foto_fondo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/FondoRedondeado" />

    <!-- HELP -->

    <androidx.cardview.widget.CardView
        android:id="@+id/CV_help"
        android:layout_width="100dp"
        android:layout_height="25dp"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="@+id/CV_TripMotorcycle"
        app:layout_constraintTop_toBottomOf="@+id/MotoSlideImg">

        <LinearLayout
            android:id="@+id/IconMenuHelp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_help"
                app:tint="?attr/colorOnSurfaceVariant">

            </ImageView>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/help">

            </TextView>
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- KM total -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="5dp"
        android:textSize="20dp"
        android:text="KM Total"
        android:textColor="?attr/colorOnPrimary"
        app:layout_constraintEnd_toEndOf="@id/CV_KmMotorcycle"
        app:layout_constraintBottom_toTopOf="@+id/CV_KmMotorcycle"
        app:layout_constraintStart_toStartOf="@+id/CV_KmMotorcycle">

    </TextView>

    <androidx.cardview.widget.CardView
        android:id="@+id/CV_KmMotorcycle"
        android:layout_width="150dp"
        android:layout_height="70dp"
        android:layout_marginStart="35dp"
        android:layout_marginTop="90dp"
        android:layout_marginEnd="17.5dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@id/CV_RemainderMotorcycleMenu"
        app:layout_constraintEnd_toStartOf="@id/CV_TripMotorcycle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/MotoSlideImg"
        app:layout_constraintVertical_chainStyle="spread_inside">

        <LinearLayout
            android:id="@+id/IconMenuStats"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="10dp"
                android:backgroundTint="?attr/colorOnSecondary"
                app:cardCornerRadius="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="KM">

                </TextView>

            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_weight="1"
                android:paddingLeft="10dp"
                android:text="0000"
                android:textSize="25dp">

            </TextView>


        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Trip A to B -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="5dp"
        android:textSize="20dp"
        android:text="Last Trip"
        android:textColor="?attr/colorOnPrimary"
        app:layout_constraintEnd_toEndOf="@id/CV_TripMotorcycle"
        app:layout_constraintBottom_toTopOf="@+id/CV_TripMotorcycle"
        app:layout_constraintStart_toStartOf="@+id/CV_TripMotorcycle">

    </TextView>

    <androidx.cardview.widget.CardView
        android:id="@+id/CV_TripMotorcycle"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginStart="17.5dp"
        android:layout_marginTop="90dp"
        android:layout_marginEnd="35dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@id/CV_MotorcycleMainMenu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/CV_KmMotorcycle"
        app:layout_constraintTop_toBottomOf="@id/MotoSlideImg"
        app:layout_constraintVertical_chainStyle="spread_inside">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <!-- Trip A -->

            <LinearLayout
                android:id="@+id/TripAMotorcycle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:layout_width="30dp"
                    android:layout_height="30dp"

                    android:layout_marginLeft="10dp"
                    android:backgroundTint="?attr/colorOnSecondary"
                    app:cardCornerRadius="5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="A">

                    </TextView>

                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"
                    android:paddingLeft="10dp"
                    android:text="0000"
                    android:textSize="25dp">

                </TextView>


            </LinearLayout>

            <!-- Línea divisoria -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="?attr/colorOutlineVariant" />

            <!-- Trip B -->

            <LinearLayout
                android:id="@+id/TripBMotorcycle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="10dp"
                    android:backgroundTint="?attr/colorOnSecondary"
                    app:cardCornerRadius="5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="B">

                    </TextView>

                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"
                    android:paddingLeft="10dp"
                    android:text="0000"
                    android:textSize="25dp">

                </TextView>


            </LinearLayout>

        </LinearLayout>


    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="5dp"
        android:textSize="20dp"
        android:text="Remainder"
        android:textColor="?attr/colorOnPrimary"
        app:layout_constraintEnd_toEndOf="@id/CV_RemainderMotorcycleMenu"
        app:layout_constraintBottom_toTopOf="@+id/CV_RemainderMotorcycleMenu"
        app:layout_constraintStart_toStartOf="@+id/CV_RemainderMotorcycleMenu">

    </TextView>

    <androidx.cardview.widget.CardView
        android:id="@+id/CV_RemainderMotorcycleMenu"
        android:layout_width="150dp"
        android:layout_height="300dp"
        android:layout_marginStart="35dp"
        android:layout_marginTop="35dp"
        android:layout_marginEnd="17.5dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/CV_KmMotorcycle"
        app:layout_constraintVertical_chainStyle="spread_inside">

    </androidx.cardview.widget.CardView>

    <!-- MOTOS -->

    <androidx.cardview.widget.CardView
        android:id="@+id/CV_MotorcycleMainMenu"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginStart="17.5dp"
        android:layout_marginEnd="35dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/CV_RemainderMotorcycleMenu"
        app:layout_constraintTop_toBottomOf="@id/CV_TripMotorcycle">

    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>