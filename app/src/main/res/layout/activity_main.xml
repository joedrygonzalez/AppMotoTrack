<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".MainActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/BottomMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/BottomMenu"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="?attr/colorOnSecondary"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Remainders list -->

        <LinearLayout
            android:id="@+id/BtnReminders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/IconReminders"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_remainder"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/TextReminders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reminders"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- ESTADÍSTICAS + GASTOS -->
        <LinearLayout
            android:id="@+id/BtnStats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/IconStats"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_stats"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/TextStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stats"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Inicio -->
        <LinearLayout
            android:id="@+id/BtnHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/IconHome"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_home"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/TextHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home"
                android:textColor="?attr/colorPrimary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- MOTOS -->
        <LinearLayout
            android:id="@+id/BtnMotos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/IconMotos"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_motorcycle"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/TextMotos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/motorcycle"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- CUENTA + SETTINGS -->
        <LinearLayout
            android:id="@+id/BtnAccount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/IconAccount"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_account_box"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/TextAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>