<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    tools:context=".MainActivity">

    <!-- IMG CARD -->

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/MotoSlideImg"
        android:layout_width="0dp"
        android:layout_height="230dp"
        android:scaleType="centerCrop"
        android:src="@drawable/foto_fondo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/FondoRedondeado" />

    <!-- HELP -->

    <androidx.cardview.widget.CardView
        android:id="@+id/CV_help"
        android:layout_width="100dp"
        android:layout_height="25dp"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="@+id/CV_RemainderMainMenu"
        app:layout_constraintTop_toBottomOf="@+id/MotoSlideImg">

        <LinearLayout
            android:id="@+id/IconMenuHelp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_help"
                app:tint="?attr/colorOnSurfaceVariant">

            </ImageView>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/help">

            </TextView>
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- ESTADÍSTICAS + GASTOS -->

    <androidx.cardview.widget.CardView
        android:id="@+id/CV_StatsMainMenu"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginStart="35dp"
        android:layout_marginEnd="17.5dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@id/CV_SettingsMainMenu"
        app:layout_constraintEnd_toStartOf="@id/CV_RemainderMainMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/MotoSlideImg"
        app:layout_constraintVertical_chainStyle="spread">

        <LinearLayout
            android:id="@+id/IconMenuStats"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center">

            <ImageView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/ic_stats"
                app:tint="?attr/colorOnSurfaceVariant">

            </ImageView>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Remainders list -->

    <androidx.cardview.widget.CardView
        android:id="@+id/CV_RemainderMainMenu"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginStart="17.5dp"
        android:layout_marginEnd="35dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@id/CV_MotorcycleMainMenu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/CV_StatsMainMenu"
        app:layout_constraintTop_toBottomOf="@id/MotoSlideImg">

        <LinearLayout
            android:id="@+id/IconMenuRemainders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center">

            <ImageView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/ic_remainder"
                app:tint="?attr/colorOnSurfaceVariant">

            </ImageView>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/CV_SettingsMainMenu"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginStart="35dp"
        android:layout_marginEnd="17.5dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@id/BottomMenu"
        app:layout_constraintEnd_toStartOf="@id/CV_MotorcycleMainMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/CV_StatsMainMenu">

        <LinearLayout
            android:id="@+id/IconMenuAccount"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center">

            <ImageView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/ic_account_box"
                app:tint="?attr/colorOnSurfaceVariant">

            </ImageView>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- MOTOS -->

    <androidx.cardview.widget.CardView
        android:id="@+id/CV_MotorcycleMainMenu"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginStart="17.5dp"
        android:layout_marginEnd="35dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@id/BottomMenu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/CV_SettingsMainMenu"
        app:layout_constraintTop_toBottomOf="@id/CV_RemainderMainMenu">

        <LinearLayout
            android:id="@+id/IconMenuMotorcycle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center">

            <ImageView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/ic_motorcycle"
                app:tint="?attr/colorOnSurfaceVariant">

            </ImageView>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/BottomMenu"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="?attr/colorSurface"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Remainders list -->
        <LinearLayout
            android:id="@+id/BtnReminders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/IconReminders"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_remainder"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/TextReminders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reminders"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- ESTADÍSTICAS + GASTOS -->
        <LinearLayout
            android:id="@+id/BtnStats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/IconStats"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_stats"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/TextStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stats"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Inicio -->
        <LinearLayout
            android:id="@+id/BtnHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/IconHome"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_home"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/TextHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home"
                android:textColor="?attr/colorPrimary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- MOTOS -->
        <LinearLayout
            android:id="@+id/BtnMotos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/IconMotos"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_motorcycle"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/TextMotos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/motorcycle"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- CUENTA + SETTINGS -->
        <LinearLayout
            android:id="@+id/BtnAccount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/IconAccount"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_account_box"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/TextAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>