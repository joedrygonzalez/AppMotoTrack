<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_edit_motorcycle"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:background="@color/darker_gray" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/edit_motorcycle"
            android:textColor="@color/black"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Kilómetros -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/km_totales"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTotalKm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/km_totales"
            android:importantForAutofill="no"
            android:inputType="number" />

        <!-- Trayectos -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/trayectos"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTripA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/trip_a_km"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/etTripB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/trip_b_km"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />

        <!-- Mantenimiento -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ltimo_mantenimiento"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etOilKm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ltimo_cambio_de_aceite_km"
            android:importantForAutofill="no"
            android:inputType="number" />

        <EditText
            android:id="@+id/etRearBrakeKm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/l_quido_freno_trasero_km"
            android:importantForAutofill="no"
            android:inputType="number" />

        <EditText
            android:id="@+id/etFrontBrakeKm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/l_quido_freno_delantero_km"
            android:importantForAutofill="no"
            android:inputType="number" />

        <!-- Botones -->

        <Button
            android:id="@+id/btnSaveMotorcycle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/darker_gray"
            android:text="@string/save"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnCancelMotorcycle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/darker_gray"
            android:text="@string/cancel"
            android:textColor="@color/white" />

    </LinearLayout>

</ScrollView>
